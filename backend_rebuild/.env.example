# ============================================================
# APPLICATION
# ============================================================

APP_NAME=HomeLink API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://127.0.0.1:8001

# ============================================================
# DATABASE / REDIS
# ============================================================

DATABASE_URL=postgresql+psycopg://homelink:homelink@localhost:5432/homelink
SQL_ECHO=false

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000

REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# ============================================================
# REQUEST CAPACITY
# ============================================================

MAX_REQUEST_BODY_BYTES=1048576

# ============================================================
# SECURITY
# ============================================================

SECRET_KEY=qyvjYqyhK5HMU-BOwDNmpQ29n_PB2CHQwrQe8ZiVX50eR-Dc7iIko0iikKB-c662
JWT_ALGORITHM=HS256
JWT_ISSUER=homelink-api
JWT_AUDIENCE=homelink-web
JWT_LEEWAY_SECONDS=10

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_REQUIRED=false

REFRESH_COOKIE_NAME=homelink_refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
FORCE_RESET_AFTER_FAILURES=10

# ============================================================
# LEGAL
# ============================================================

TERMS_VERSION=2026-09-24
PRIVACY_VERSION=2026-09-24
LEGAL_EFFECTIVE_DATE=2026-09-24
LEGAL_CONTACT_EMAIL=homelink814@gmail.com
COMPANY_LEGAL_NAME=HomeLink
LEGAL_DOCUMENTS_ARE_DRAFTS=true

# ============================================================
# SMTP
# ============================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HomeLink
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ============================================================
# NETWORK
# ============================================================

TRUST_PROXY_HEADERS=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# ============================================================
# FREE LAUNCH ALLOWANCES
# ============================================================

FREE_MARKETPLACE_LISTINGS=1
FREE_RENTAL_LISTINGS=1
FREE_BUY_PROPERTY_LISTINGS=1

# ============================================================
# PAYMENTS
# ============================================================

PAYMENT_PROVIDER=mock
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback

PAYSTACK_MODE=test
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

FLUTTERWAVE_MODE=test
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# ============================================================
# CLOUDINARY
# ============================================================

CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=homelink

# ============================================================
# RETENTION
# ============================================================

SESSION_CLEANUP_GRACE_DAYS=7
TOKEN_CLEANUP_RETENTION_DAYS=7
READ_NOTIFICATION_RETENTION_DAYS=180
AGENT_DOCUMENT_RETENTION_DAYS=30
WEBHOOK_EVENT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365